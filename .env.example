# PayPal sandbox app credentials (developer.paypal.com -> Apps & Credentials -> Sandbox).
# Leave blank to run against the built-in PayPal simulator instead.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Anthropic API key (console.anthropic.com). Needed for the chat agent, the manipulation
# detector and the plain-English policy compiler. Without it the guard uses a keyword heuristic.
ANTHROPIC_API_KEY=

# Optional overrides
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_EFFORT=medium
# UTILITY_MODEL=claude-haiku-5-5   # detector + policy compiler
# PAYPAL_MODE=mock          # force the simulator even when PayPal keys are set
# ANTHROPIC_FALLBACKS=1     # server-side refusal fallbacks (beta)
